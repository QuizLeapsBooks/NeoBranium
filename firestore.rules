rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Security events (write-only via Admin SDK) ────────────────────────────
    // Clients can never read or write security_events — Admin SDK only.
    match /security_events/{docId} {
      allow read, write: if false;
    }

    // ── AI quota tracking (write-only via Admin SDK) ──────────────────────────
    // Per-UID daily quotas written atomically by the backend. No client access.
    match /ai_quotas/{uid} {
      allow read, write: if false;
    }

    // ── AI Board sessions (written by Admin SDK, not by clients) ─────────────
    match /aiboard_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ── WhatsApp Queue (Admin SDK only) ──────────────────────────────────────
    match /whatsapp_queue/{docId} {
      allow read, write: if false;
    }

    // ── User profiles (NeoBranium & NeoMentor) ─────────────────────────────────
    // Users may read/write their own document EXCEPT privileged server-managed fields.
    // Sensitive fields (role, subscription, score, highScore, rank, isAdmin, isBanned)
    // must only be written by the server (Admin SDK bypasses these rules).
    match /users/{userId} {
      // Allow read of own document
      allow read: if isOwner(userId);

      // Allow create of own document — but block privileged fields
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fname', 'lname', 'username', 'bio', 'phone', 'email', 'photoURL',
          'profilePhotoUrl', 'notificationPref', 'messagePrivacy', 'readReceipts',
          'thoughtOfTheDay', 'thoughtOfTheDayExpiresAt', 'thoughtOfTheDayCreatedAt',
          'showLastSeen', 'createdAt', 'updatedAt'
        ])
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('isBanned' in request.resource.data)
        && !('subscription' in request.resource.data)
        && !('score' in request.resource.data)
        && !('highScore' in request.resource.data)
        && !('rank' in request.resource.data);

      // Allow update of own document — but block privileged fields from being changed
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fname', 'lname', 'username', 'bio', 'phone', 'email', 'photoURL',
          'profilePhotoUrl', 'notificationPref', 'messagePrivacy', 'readReceipts',
          'thoughtOfTheDay', 'thoughtOfTheDayExpiresAt', 'thoughtOfTheDayCreatedAt',
          'showLastSeen', 'updatedAt'
        ])
        && (!('fname' in request.resource.data) || (request.resource.data.fname is string && request.resource.data.fname.size() <= 100))
        && (!('lname' in request.resource.data) || (request.resource.data.lname is string && request.resource.data.lname.size() <= 100))
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() <= 100))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && (!('profilePhotoUrl' in request.resource.data) || (request.resource.data.profilePhotoUrl is string && request.resource.data.profilePhotoUrl.size() <= 2048))
        && (!('notificationPref' in request.resource.data) || request.resource.data.notificationPref in ['all', 'important', 'none'])
        && (!('messagePrivacy' in request.resource.data) || request.resource.data.messagePrivacy in ['everyone', 'learning_only', 'none'])
        && (!('readReceipts' in request.resource.data) || request.resource.data.readReceipts is bool)
        && (!('thoughtOfTheDay' in request.resource.data) || (request.resource.data.thoughtOfTheDay is string && request.resource.data.thoughtOfTheDay.size() <= 280))
        && (!('thoughtOfTheDayExpiresAt' in request.resource.data) || request.resource.data.thoughtOfTheDayExpiresAt is timestamp)
        && (!('thoughtOfTheDayCreatedAt' in request.resource.data) || request.resource.data.thoughtOfTheDayCreatedAt is timestamp)
        && (!('showLastSeen' in request.resource.data) || request.resource.data.showLastSeen is bool);

      // No direct client deletes of root profile
      allow delete: if false;

      // Conserve user sub-collections for NeoMentor and NeoBranium features
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── NeoMentor collections (Conserved for integrated 2nd project) ───────────
    // All mentor collections are scoped to the authenticated owner (userId).

    match /mentor_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_activity/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_memory/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_goals/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_chat/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_reflections/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{reflectionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_calendar/{userId} {
      allow read, write: if isOwner(userId);
      match /days/{dayId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_analytics/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Note reactions (like / dislike) ───────────────────────────────────────
    function isValidReactionCreate() {
      let data = request.resource.data;
      return isSignedIn()
        && data.keys().hasOnly(['likes', 'dislikes', 'users'])
        && data.likes is int && data.likes >= 0
        && data.dislikes is int && data.dislikes >= 0
        && data.users is map
        && data.users.keys().hasOnly([request.auth.uid])
        && (
          (data.users[request.auth.uid] == 'like' && data.likes == 1 && data.dislikes == 0)
          || (data.users[request.auth.uid] == 'dislike' && data.likes == 0 && data.dislikes == 1)
        );
    }

    function isValidReactionTransition(prevReaction, nextReaction, dLikes, dDislikes) {
      return (
        // Case 1: New like
        (prevReaction == null && nextReaction == 'like' && dLikes == 1 && dDislikes == 0)
        // Case 2: New dislike
        || (prevReaction == null && nextReaction == 'dislike' && dLikes == 0 && dDislikes == 1)
        // Case 3: Undo like
        || (prevReaction == 'like' && nextReaction == null && dLikes == -1 && dDislikes == 0)
        // Case 4: Undo dislike
        || (prevReaction == 'dislike' && nextReaction == null && dLikes == 0 && dDislikes == -1)
        // Case 5: Switch like to dislike
        || (prevReaction == 'like' && nextReaction == 'dislike' && dLikes == -1 && dDislikes == 1)
        // Case 6: Switch dislike to like
        || (prevReaction == 'dislike' && nextReaction == 'like' && dLikes == 1 && dDislikes == -1)
        // Case 7: Idempotent / no-op
        || (prevReaction == nextReaction && dLikes == 0 && dDislikes == 0)
      );
    }

    function isValidReactionUpdate() {
      let data = request.resource.data;
      let current = resource.data;
      let prevLikes = ('likes' in current && current.likes is int) ? current.likes : 0;
      let prevDislikes = ('dislikes' in current && current.dislikes is int) ? current.dislikes : 0;
      let dLikes = data.likes - prevLikes;
      let dDislikes = data.dislikes - prevDislikes;
      let prevReaction = ('users' in current && current.users is map && request.auth.uid in current.users)
        ? current.users[request.auth.uid]
        : null;
      let nextReaction = (request.auth.uid in data.users)
        ? data.users[request.auth.uid]
        : null;

      return isSignedIn()
        && data.keys().hasOnly(['likes', 'dislikes', 'users'])
        && data.likes is int && data.likes >= 0
        && data.dislikes is int && data.dislikes >= 0
        && data.users is map
        && (
          (!('users' in current) || !(current.users is map))
            ? data.users.keys().hasOnly([request.auth.uid])
            : data.users.diff(current.users).affectedKeys().hasOnly([request.auth.uid])
        )
        && (nextReaction == null || nextReaction in ['like', 'dislike'])
        && isValidReactionTransition(prevReaction, nextReaction, dLikes, dDislikes);
    }

    match /reactions/{noteId} {
      allow read: if isSignedIn();
      allow delete: if false;
      allow create: if isValidReactionCreate();
      allow update: if isValidReactionUpdate();
    }

    // ── Exam papers & evaluations (Managed strictly via backend Paper Service) ──
    match /exam_papers/{paperId} {
      allow read, write: if false;
    }
    match /paper_model_answers/{paperId} {
      allow read, write: if false;
    }
    match /paper_evaluations/{paperId} {
      allow read, write: if false;
    }


    // ── NeoLearn: Report validation helpers ───────────────────────────────────

    function isValidNeoLearnReportReason(reason) {
      return reason in ['Spam', 'Inappropriate content', 'Harassment', 'Other'];
    }

    function isValidNeoLearnPostReport(reportId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'post'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 256
        && !request.resource.data.postId.matches('.*[/].*')
        && (request.resource.data.reportedUserId == null || request.resource.data.reportedUserId is string)
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'post_' + request.auth.uid + '_' + request.resource.data.postId;
    }

    function isValidNeoLearnProfileReport(reportId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'profile'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reportedUserId.size() <= 128
        && !request.resource.data.reportedUserId.matches('.*[/].*')
        && request.resource.data.reportedUserId != request.auth.uid
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'profile_' + request.auth.uid + '_' + request.resource.data.reportedUserId;
    }

    function isValidNeoLearnBlock(blockId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId.size() > 0
        && request.resource.data.blockedUserId.size() <= 128
        && !request.resource.data.blockedUserId.matches('.*[/].*')
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.createdAt is timestamp
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId;
    }

    // ── NeoLearn profiles ─────────────────────────────────────────────────────
    // Clients can read any profile (public feed). Create is validated; updates/deletes via Admin SDK.
    match /neolearn_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.profilePhotoUrl is string
        && request.resource.data.profilePhotoUrl.size() <= 2048
        && request.resource.data.thoughtOfTheDay is string
        && request.resource.data.thoughtOfTheDay.size() <= 280
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if false;  // Admin SDK only
    }

    // ── NeoLearn posts ────────────────────────────────────────────────────────
    // Authenticated users can read. Owner can delete own post. Creates/updates via Admin SDK.
    match /neolearn_posts/{postId} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // ── NeoLearn moments ─────────────────────────────────────────────────────
    match /neolearn_moments/{momentId} {
      allow read, write: if false;  // Admin SDK only
    }

    // ── NeoLearn reports ─────────────────────────────────────────────────────
    // Users can submit a report for a post or profile; no reads or updates.
    match /neolearn_reports/{reportId} {
      allow create: if isValidNeoLearnPostReport(reportId) || isValidNeoLearnProfileReport(reportId);
      allow read, update, delete: if false;
    }

    // ── NeoLearn blocks ───────────────────────────────────────────────────────
    // Users can block/unblock through the validated Admin SDK route or client read/delete.
    match /neolearn_blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isValidNeoLearnBlock(blockId);
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ── NeoLearn learning connections ─────────────────────────────────────────
    match /neolearn_learning/{relationId} {
      allow read: if isSignedIn();
      allow write: if false;  // Admin SDK only
    }

    // ── Impression tracking ───────────────────────────────────────────────────
    // Admin SDK transactions are the only write path; clients cannot forge counts.
    match /neolearn_post_impressions/{viewerUid} {
      allow read, write: if false;   // top-level: no direct client access

      match /posts/{postId} {
        allow read: if isSignedIn() && request.auth.uid == viewerUid;
        allow write: if false;   // all writes via Admin SDK (bypasses rules)
      }
    }

    // ── Default: deny all unmatched paths ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
