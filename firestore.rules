rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNeoLearnPostVisibleToViewer(ownerId) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/neolearn_blocks/$(request.auth.uid + '_' + ownerId))
        && !exists(/databases/$(database)/documents/neolearn_blocks/$(ownerId + '_' + request.auth.uid));
    }

    function isValidImpressionRecord() {
      return resource.data.keys().hasAll(['count', 'lastShownAt'])
        && resource.data.count is int
        && resource.data.count >= 0
        && resource.data.count <= 3
        && resource.data.lastShownAt is timestamp
        && (!resource.data.keys().hasAny(['surfaceIds']) || resource.data.surfaceIds is list);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_activity/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_memory/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_goals/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_chat/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_reflections/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{reflectionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_calendar/{userId} {
      allow read, write: if isOwner(userId);
      match /days/{dayId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_analytics/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /reactions/{noteId} {
      allow read, write: if request.auth != null;
    }

    match /aiboard_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /whatsapp_queue/{docId} {
      allow read, write: if false;
    }

    match /neolearn_profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.profilePhotoUrl is string
        && request.resource.data.profilePhotoUrl.size() <= 2048
        && request.resource.data.thoughtOfTheDay is string
        && request.resource.data.thoughtOfTheDay.size() <= 280
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if false;
    }

    match /neolearn_posts/{postId} {
      allow read: if resource.data.userId is string && isNeoLearnPostVisibleToViewer(resource.data.userId);
      allow create, update, delete: if false;
    }

    match /neolearn_reports/{reportId} {
      allow read, write: if false;
    }

    match /neolearn_blocks/{blockId} {
      allow read, write: if false;
    }

    match /neolearn_learning/{relationId} {
      allow read, write: if false;
    }

    // ── Impression tracking ───────────────────────────────────────────────────
    // neolearn_post_impressions/{viewerUid}/posts/{postId}
    //
    // Admin SDK transactions are the only write path; clients cannot forge counts.
    // Feed requests read at most their bounded candidate IDs through the backend.
    match /neolearn_post_impressions/{viewerUid} {
      allow read, write: if false;

      match /posts/{postId} {
        allow read: if isOwner(viewerUid)
          && postId.size() > 0
          && postId.size() <= 256
          && isValidImpressionRecord();
        allow write: if false;
      }
    }
  }
}
