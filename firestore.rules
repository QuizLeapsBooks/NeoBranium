rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidNeoLearnReportReason(reason) {
      return reason in ['Spam', 'Inappropriate content', 'Harassment', 'Other'];
    }

    function isValidNeoLearnPostReport(reportId) {
      return request.auth != null
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'post'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 256
        && !request.resource.data.postId.matches('.*[/].*')
        && (request.resource.data.reportedUserId == null || request.resource.data.reportedUserId is string)
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'post_' + request.auth.uid + '_' + request.resource.data.postId;
    }

    function isValidNeoLearnProfileReport(reportId) {
      return request.auth != null
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'profile'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reportedUserId.size() <= 128
        && !request.resource.data.reportedUserId.matches('.*[/].*')
        && request.resource.data.reportedUserId != request.auth.uid
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'profile_' + request.auth.uid + '_' + request.resource.data.reportedUserId;
    }

    function isValidNeoLearnBlock(blockId) {
      return request.auth != null
        && request.resource.data.keys().hasAll(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId.size() > 0
        && request.resource.data.blockedUserId.size() <= 128
        && !request.resource.data.blockedUserId.matches('.*[/].*')
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.createdAt is timestamp
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_activity/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_memory/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_goals/{userId} {
      allow read, write: if isOwner(userId);
      allow read, write: if isOwner(userId);
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      allow read: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if false;
        allow read, write: if isOwner(userId);
      }
    }
      allow create: if isValidNeoLearnPostReport(reportId) || isValidNeoLearnProfileReport(reportId);
      allow read, update, delete: if false;
    match /mentor_calendar/{userId} {
      allow read, write: if isOwner(userId);
      match /days/{dayId} {
      allow read: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow create: if isValidNeoLearnBlock(blockId);
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
      }
    }

      allow read: if request.auth != null;
      allow write: if false;
      allow read, write: if isOwner(userId);

      allow read, write: if false;   // top-level: no direct client access
      allow read, write: if false;
    }
        allow read:  if request.auth != null && request.auth.uid == viewerUid;
        allow write: if false;   // all writes via Admin SDK (bypasses rules)
    match /neolearn_profiles/{userId} {
      allow read: if isOwner(userId);
    match /neolearn_moments/{momentId} {
      allow read, write: if false;
    }
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.profilePhotoUrl is string
        && request.resource.data.profilePhotoUrl.size() <= 2048
        && request.resource.data.thoughtOfTheDay is string
        && request.resource.data.thoughtOfTheDay.size() <= 280
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if false;
    }

    match /neolearn_posts/{postId} {
      allow read: if resource.data.userId is string && isNeoLearnPostVisibleToViewer(resource.data.userId);
      allow create, update, delete: if false;
    }

    match /neolearn_moments/{momentId} {
      allow read, write: if false;
    }

    match /neolearn_reports/{reportId} {
      allow read, write: if false;
    }

    match /neolearn_blocks/{blockId} {
      allow read, write: if false;
    }

    match /neolearn_learning/{relationId} {
      allow read, write: if false;
    }

    // ── Impression tracking ───────────────────────────────────────────────────
    // neolearn_post_impressions/{viewerUid}/posts/{postId}
    //
    // Admin SDK transactions are the only write path; clients cannot forge counts.
    // Feed requests read at most their bounded candidate IDs through the backend.
    match /neolearn_post_impressions/{viewerUid} {
      allow read, write: if false;

      match /posts/{postId} {
        allow read: if isOwner(viewerUid)
          && postId.size() > 0
          && postId.size() <= 256
          && isValidImpressionRecord();
        allow write: if false;
      }
    }
  }
}
