rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model - NeoCalender Sub-collections
    // ===============================================================
    // Collection: /users/{userId}/neocalender_tasks/{taskId}
    // Fields:
    //   - id: string (optional, matches taskId)
    //   - uid: string (optional, matches userId)
    //   - title: string (required, 1..300 chars)
    //   - description: string (optional, <= 5000 chars)
    //   - status: string (required, 'pending' | 'completed')
    //   - priority: string (required, 'low' | 'medium' | 'high' | 'urgent')
    //   - category: string (optional, <= 100 chars)
    //   - listId: string (optional, <= 100 chars)
    //   - dueDate, startDate, completedAt: string | timestamp | null
    //   - dueTime, startTime: string (optional, <= 32 chars)
    //   - reminder: string | bool | int | map | null
    //   - recurrence: string (optional, 'none'|'daily'|'weekly'|'monthly'|'custom')
    //   - recurrenceInterval: int | float
    //   - subtasks: list (<= 100 items)
    //   - tags: list (<= 50 items)
    //   - order: int | float
    //   - completionHistory: list (<= 1000 items)
    //   - createdAt: string | timestamp (immutable on update)
    //   - updatedAt: string | timestamp
    //
    // Collection: /users/{userId}/neocalender_lists/{listId}
    // Fields:
    //   - id: string (optional, matches listId)
    //   - uid: string (optional, matches userId)
    //   - name: string (required, 1..100 chars)
    //   - color: string (optional, <= 32 chars)
    //   - icon: string (optional, <= 64 chars)
    //   - isDefault: bool
    //   - order: int | float
    //   - createdAt: string | timestamp (immutable on update)
    //   - updatedAt: string | timestamp
    //
    // Collection: /users/{userId}/neocalender_settings/{settingId}
    // Fields:
    //   - remindersEnabled: bool
    //   - notificationPref: string ('all' | 'important' | 'none')
    //   - defaultPriority: string ('low' | 'medium' | 'high' | 'urgent')
    //   - preferredView: string ('month' | 'week' | 'day' | 'tasks' | 'upcoming')
    //   - weekStartDay: string ('monday' | 'sunday')
    //   - dailySummaryTime: string (<= 10 chars)
    //   - aiAutonomy: string ('confirm_destructive' | 'auto_quick_actions')
    //   - timeZone: string (<= 64 chars)
    //   - createdAt, updatedAt: string | timestamp
    //
    // Collection: /users/{userId}/neocalender_events/{eventId}
    // Fields:
    //   - id, uid: string
    //   - title: string (required, 1..300 chars)
    //   - description: string (optional, <= 5000 chars)
    //   - startDate: string | timestamp
    //   - endDate: string | timestamp | null
    //   - startTime, endTime: string | null
    //   - allDay: bool
    //   - location, color, category, reminder, recurrence
    //   - createdAt, updatedAt: string | timestamp
    // ===============================================================

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── NeoCalender validation helpers ────────────────────────────────────────

    function isValidNeoCalenderTask(data, userId, taskId) {
      return (!('uid' in data) || data.uid == userId)
        && (!('id' in data) || (data.id is string && data.id.size() <= 128 && data.id == taskId))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && data.status in ['pending', 'completed']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('listId' in data) || (data.listId is string && data.listId.size() <= 100))
        && (!('dueDate' in data) || data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 64) || data.dueDate is timestamp)
        && (!('dueTime' in data) || data.dueTime == null || (data.dueTime is string && data.dueTime.size() <= 32))
        && (!('startDate' in data) || data.startDate == null || (data.startDate is string && data.startDate.size() <= 64) || data.startDate is timestamp)
        && (!('startTime' in data) || data.startTime == null || (data.startTime is string && data.startTime.size() <= 32))
        && (!('reminder' in data) || data.reminder == null || (data.reminder is string && data.reminder.size() <= 100) || data.reminder is bool || data.reminder is int || data.reminder is map)
        && (!('recurrence' in data) || data.recurrence in ['none', 'daily', 'weekly', 'monthly', 'custom'])
        && (!('recurrenceInterval' in data) || data.recurrenceInterval is int || data.recurrenceInterval is float)
        && (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 100))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 50))
        && (!('order' in data) || data.order is int || data.order is float)
        && (!('completionHistory' in data) || (data.completionHistory is list && data.completionHistory.size() <= 1000))
        && (!('completedAt' in data) || data.completedAt == null || (data.completedAt is string && data.completedAt.size() <= 64) || data.completedAt is timestamp)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp);
    }

    function isValidNeoCalenderList(data, userId, listId) {
      return (!('uid' in data) || data.uid == userId)
        && (!('id' in data) || (data.id is string && data.id.size() <= 128 && data.id == listId))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('color' in data) || (data.color is string && data.color.size() <= 32))
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 64))
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('order' in data) || data.order is int || data.order is float)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp);
    }

    function isValidNeoCalenderSettings(data) {
      return (!('remindersEnabled' in data) || data.remindersEnabled is bool)
        && (!('notificationPref' in data) || data.notificationPref in ['all', 'important', 'none'])
        && (!('defaultPriority' in data) || data.defaultPriority in ['low', 'medium', 'high', 'urgent'])
        && (!('preferredView' in data) || data.preferredView in ['month', 'week', 'day', 'tasks', 'upcoming'])
        && (!('weekStartDay' in data) || data.weekStartDay in ['monday', 'sunday'])
        && (!('dailySummaryTime' in data) || (data.dailySummaryTime is string && data.dailySummaryTime.size() <= 10))
        && (!('aiAutonomy' in data) || data.aiAutonomy in ['confirm_destructive', 'auto_quick_actions'])
        && (!('timeZone' in data) || (data.timeZone is string && data.timeZone.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp);
    }

    function isValidNeoCalenderEvent(data, userId, eventId) {
      return (!('uid' in data) || data.uid == userId)
        && (!('id' in data) || (data.id is string && data.id.size() <= 128 && data.id == eventId))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 64) || data.startDate is timestamp)
        && (!('endDate' in data) || data.endDate == null || (data.endDate is string && data.endDate.size() <= 64) || data.endDate is timestamp)
        && (!('startTime' in data) || data.startTime == null || (data.startTime is string && data.startTime.size() <= 32))
        && (!('endTime' in data) || data.endTime == null || (data.endTime is string && data.endTime.size() <= 32))
        && (!('allDay' in data) || data.allDay is bool)
        && (!('location' in data) || (data.location is string && data.location.size() <= 300))
        && (!('color' in data) || (data.color is string && data.color.size() <= 32))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('reminder' in data) || data.reminder == null || (data.reminder is string && data.reminder.size() <= 100) || data.reminder is bool || data.reminder is int || data.reminder is map)
        && (!('recurrence' in data) || (data.recurrence is string && data.recurrence.size() <= 32))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp);
    }

    // ── Security events (write-only via Admin SDK) ────────────────────────────
    // Clients can never read or write security_events — Admin SDK only.
    match /security_events/{docId} {
      allow read, write: if false;
    }

    // ── AI quota tracking (write-only via Admin SDK) ──────────────────────────
    // Per-UID daily quotas written atomically by the backend. No client access.
    match /ai_quotas/{uid} {
      allow read, write: if false;
    }

    // ── WhatsApp Queue (Admin SDK only) ──────────────────────────────────────
    match /whatsapp_queue/{docId} {
      allow read, write: if false;
    }

    // ── User profiles (NeoBranium & NeoMentor) ─────────────────────────────────
    // Users may read/write their own document EXCEPT privileged server-managed fields.
    // Sensitive fields (role, subscription, score, highScore, rank, isAdmin, isBanned)
    // must only be written by the server (Admin SDK bypasses these rules).
    match /users/{userId} {
      // Allow read of own document
      allow read: if isOwner(userId);

      // Allow create of own document — but block privileged fields
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fname', 'lname', 'username', 'bio', 'phone', 'email', 'photoURL',
          'profilePhotoUrl', 'notificationPref', 'messagePrivacy', 'readReceipts',
          'thoughtOfTheDay', 'thoughtOfTheDayExpiresAt', 'thoughtOfTheDayCreatedAt',
          'showLastSeen', 'showOnLeaderboard', 'leaderboardPrivacy', 'targetClass',
          'publicDisplayName', 'createdAt', 'updatedAt'
        ])
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('isBanned' in request.resource.data)
        && !('subscription' in request.resource.data)
        && !('score' in request.resource.data)
        && !('highScore' in request.resource.data)
        && !('rank' in request.resource.data);

      // Allow update of own document — but block privileged fields from being changed
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fname', 'lname', 'username', 'bio', 'phone', 'email', 'photoURL',
          'profilePhotoUrl', 'notificationPref', 'messagePrivacy', 'readReceipts',
          'thoughtOfTheDay', 'thoughtOfTheDayExpiresAt', 'thoughtOfTheDayCreatedAt',
          'showLastSeen', 'showOnLeaderboard', 'leaderboardPrivacy', 'targetClass',
          'publicDisplayName', 'updatedAt'
        ])
        && (!('fname' in request.resource.data) || (request.resource.data.fname is string && request.resource.data.fname.size() <= 100))
        && (!('lname' in request.resource.data) || (request.resource.data.lname is string && request.resource.data.lname.size() <= 100))
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() <= 100))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && (!('profilePhotoUrl' in request.resource.data) || (request.resource.data.profilePhotoUrl is string && request.resource.data.profilePhotoUrl.size() <= 2048))
        && (!('notificationPref' in request.resource.data) || request.resource.data.notificationPref in ['all', 'important', 'none'])
        && (!('messagePrivacy' in request.resource.data) || request.resource.data.messagePrivacy in ['everyone', 'learning_only', 'none'])
        && (!('readReceipts' in request.resource.data) || request.resource.data.readReceipts is bool)
        && (!('thoughtOfTheDay' in request.resource.data) || (request.resource.data.thoughtOfTheDay is string && request.resource.data.thoughtOfTheDay.size() <= 280))
        && (!('thoughtOfTheDayExpiresAt' in request.resource.data) || request.resource.data.thoughtOfTheDayExpiresAt is timestamp)
        && (!('thoughtOfTheDayCreatedAt' in request.resource.data) || request.resource.data.thoughtOfTheDayCreatedAt is timestamp)
        && (!('showLastSeen' in request.resource.data) || request.resource.data.showLastSeen is bool)
        && (!('showOnLeaderboard' in request.resource.data) || request.resource.data.showOnLeaderboard is bool)
        && (!('leaderboardPrivacy' in request.resource.data) || request.resource.data.leaderboardPrivacy in ['public', 'private'])
        && (!('targetClass' in request.resource.data) || request.resource.data.targetClass in ['9', '10'])
        && (!('publicDisplayName' in request.resource.data) || (request.resource.data.publicDisplayName is string && request.resource.data.publicDisplayName.size() <= 100));

      // No direct client deletes of root profile
      allow delete: if false;

      // ── AI Conversation History sub-collections ──────────────────────────
      // All writes go through the server (Admin SDK) so auth, sanitisation,
      // and soft-delete semantics are enforced centrally.
      // Clients may only READ their own (non-deleted) conversations & messages.
      match /conversations/{conversationId} {
        allow read: if isOwner(userId) && resource.data.isDeleted == false;
        allow write: if false; // Admin SDK only

        match /messages/{messageId} {
          allow read: if isOwner(userId) && resource.data.isDeleted == false;
          allow write: if false; // Admin SDK only
        }
      }

      // ── AI Usage Daily sub-collection (NB-SEC-01) ─────────────────────────
      // Authoritative token and budget accounting is handled exclusively by
      // backend services using Admin SDK. Clients may read their own records
      // to display quota progress, but client writes are blocked.
      match /ai_usage_daily/{date} {
        allow read: if isOwner(userId);
        allow write: if false; // Admin SDK only
      }

      // ── NeoCalender: Tasks sub-collection ─────────────────────────────────
      // Users may read and write their own tasks with strict schema, ownership,
      // and field value validation (title, status, priority, bounds).
      match /neocalender_tasks/{taskId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'status', 'priority'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'status', 'priority', 'category', 'listId',
            'dueDate', 'dueTime', 'startDate', 'startTime', 'reminder', 'recurrence',
            'recurrenceInterval', 'subtasks', 'tags', 'order', 'completionHistory',
            'completedAt', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderTask(request.resource.data, userId, taskId);
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'status', 'priority'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'status', 'priority', 'category', 'listId',
            'dueDate', 'dueTime', 'startDate', 'startTime', 'reminder', 'recurrence',
            'recurrenceInterval', 'subtasks', 'tags', 'order', 'completionHistory',
            'completedAt', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderTask(request.resource.data, userId, taskId)
          && (!('uid' in resource.data) || !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
          && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      }

      // ── NeoCalender: Custom Lists sub-collection ──────────────────────────
      // Scoped to the authenticated owner with name validation and bounds.
      match /neocalender_lists/{listId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'name', 'color', 'icon', 'isDefault', 'order', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderList(request.resource.data, userId, listId);
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'name', 'color', 'icon', 'isDefault', 'order', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderList(request.resource.data, userId, listId)
          && (!('uid' in resource.data) || !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
          && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      }

      // ── NeoCalender: Settings & Preferences sub-collection ────────────────
      // Scoped to the authenticated owner with enum and range validation.
      match /neocalender_settings/{settingId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'remindersEnabled', 'notificationPref', 'defaultPriority', 'preferredView',
            'weekStartDay', 'dailySummaryTime', 'aiAutonomy', 'timeZone', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderSettings(request.resource.data);
      }

      // ── NeoCalender: Events sub-collection ────────────────────────────────
      // Scoped to the authenticated owner with title and field validation.
      match /neocalender_events/{eventId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'startDate', 'endDate', 'startTime', 'endTime',
            'allDay', 'location', 'color', 'category', 'reminder', 'recurrence', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderEvent(request.resource.data, userId, eventId);
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'startDate', 'endDate', 'startTime', 'endTime',
            'allDay', 'location', 'color', 'category', 'reminder', 'recurrence', 'createdAt', 'updatedAt'
          ])
          && isValidNeoCalenderEvent(request.resource.data, userId, eventId)
          && (!('uid' in resource.data) || !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
          && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
          && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      }

      // ── NeoCalender: Habits sub-collection ───────────────────────────────────
      match /neocalender_habits/{habitId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'frequency'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'frequency', 'customDays',
            'category', 'color', 'icon', 'targetCount', 'reminderTime',
            'status', 'currentStreak', 'longestStreak', 'totalCompletions',
            'completionDates', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.frequency in ['daily', 'weekly', 'custom'];
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'frequency'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'frequency', 'customDays',
            'category', 'color', 'icon', 'targetCount', 'reminderTime',
            'status', 'currentStreak', 'longestStreak', 'totalCompletions',
            'completionDates', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ── NeoCalender: Routines sub-collection ─────────────────────────────────
      match /neocalender_routines/{routineId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'name', 'description', 'category', 'activities',
            'estimatedMinutes', 'scheduledDays', 'startTime', 'isActive',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id;
      }

      // ── NeoCalender: Goals sub-collection ────────────────────────────────────
      match /neocalender_goals/{goalId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'category'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'title', 'description', 'category', 'priority',
            'startDate', 'targetDate', 'status', 'progress', 'progressHistory',
            'associatedTaskIds', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.category in [
            'academic', 'personal', 'health', 'career', 'project', 'custom'
          ];
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ── NeoCalender: Milestones sub-collection ───────────────────────────────
      match /neocalender_milestones/{milestoneId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'goalId'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'goalId', 'title', 'description', 'targetDate',
            'status', 'order', 'associatedTaskIds', 'completedAt',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId;
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.goalId == resource.data.goalId;
      }

      // ── NeoCalender: Focus Sessions sub-collection ───────────────────────────
      match /neocalender_focus_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['startTime', 'durationMinutes'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'taskId', 'taskTitle', 'startTime', 'endTime',
            'durationMinutes', 'actualMinutes', 'breakMinutes', 'intervals',
            'status', 'notes', 'createdAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 1
          && request.resource.data.durationMinutes <= 480;
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id;
      }

      // ── NeoCalender: Time Blocks sub-collection ───────────────────────────────
      match /neocalender_time_blocks/{blockId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['date', 'startTime', 'endTime', 'title'])
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'date', 'startTime', 'endTime', 'title', 'description',
            'taskId', 'category', 'color', 'type', 'isBreak', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id;
      }

      // Preserve existing access to other user sub-collections, but do not let
      // this broad legacy grant override the stricter conversation or quota rules above.
      match /{subCollection}/{document=**} {
        allow read, write: if isOwner(userId)
          && subCollection != 'conversations'
          && subCollection != 'ai_usage_daily'
          && subCollection != 'neocalender_tasks'
          && subCollection != 'neocalender_lists'
          && subCollection != 'neocalender_settings'
          && subCollection != 'neocalender_events'
          && subCollection != 'neocalender_habits'
          && subCollection != 'neocalender_routines'
          && subCollection != 'neocalender_goals'
          && subCollection != 'neocalender_milestones'
          && subCollection != 'neocalender_focus_sessions'
          && subCollection != 'neocalender_time_blocks';
      }
    }

    // ── Public student leaderboard & profiles ─────────────────────────────────
    // Anyone (guests, unauthenticated visitors, students) can view public profiles.
    // Client creation & update are blocked: all calculations & ranking updates
    // are performed securely via the backend / Admin SDK to prevent score manipulation.
    // The account owner may delete their public profile if toggled to private.
    match /public_profiles/{userId} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow create, update: if false; // Admin SDK only
    }

    // ── NeoMentor collections (Conserved for integrated 2nd project) ───────────
    // All mentor collections are scoped to the authenticated owner (userId).

    match /mentor_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_activity/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_memory/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_goals/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{goalId} {
        allow read, write: if isOwner(userId);
      }
      match /roadmap_items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_chat/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_reflections/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{reflectionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_calendar/{userId} {
      allow read, write: if isOwner(userId);
      match /days/{dayId} {
        allow read: if isOwner(userId);
        // Direct client creation/update is allowed ONLY for non-authoritative daily activity (e.g. visited: true).
        // Authoritative quiz fields (quizCompleted, quizCount, quizIds, quizDetails, score, accuracy, verifiedQuizzes, verified)
        // must NEVER be written or altered by the client SDK. All quiz scoring is verified server-side.
        allow create: if isOwner(userId)
          && !request.resource.data.keys().hasAny(['quizCompleted', 'quizCount', 'quizIds', 'quizDetails', 'score', 'accuracy', 'verifiedQuizzes', 'verified']);
        allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['quizCompleted', 'quizCount', 'quizIds', 'quizDetails', 'score', 'accuracy', 'verifiedQuizzes', 'verified']);
        allow delete: if false;
      }
    }

    match /mentor_analytics/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Note reactions (like / dislike) ───────────────────────────────────────
    function isValidReactionCreate() {
      let data = request.resource.data;
      return isSignedIn()
        && data.keys().hasOnly(['likes', 'dislikes', 'users'])
        && data.likes is int && data.likes >= 0
        && data.dislikes is int && data.dislikes >= 0
        && data.users is map
        && data.users.keys().hasOnly([request.auth.uid])
        && (
          (data.users[request.auth.uid] == 'like' && data.likes == 1 && data.dislikes == 0)
          || (data.users[request.auth.uid] == 'dislike' && data.likes == 0 && data.dislikes == 1)
        );
    }

    function isValidReactionTransition(prevReaction, nextReaction, dLikes, dDislikes) {
      return (
        // Case 1: New like
        (prevReaction == null && nextReaction == 'like' && dLikes == 1 && dDislikes == 0)
        // Case 2: New dislike
        || (prevReaction == null && nextReaction == 'dislike' && dLikes == 0 && dDislikes == 1)
        // Case 3: Undo like
        || (prevReaction == 'like' && nextReaction == null && dLikes == -1 && dDislikes == 0)
        // Case 4: Undo dislike
        || (prevReaction == 'dislike' && nextReaction == null && dLikes == 0 && dDislikes == -1)
        // Case 5: Switch like to dislike
        || (prevReaction == 'like' && nextReaction == 'dislike' && dLikes == -1 && dDislikes == 1)
        // Case 6: Switch dislike to like
        || (prevReaction == 'dislike' && nextReaction == 'like' && dLikes == 1 && dDislikes == -1)
        // Case 7: Idempotent / no-op
        || (prevReaction == nextReaction && dLikes == 0 && dDislikes == 0)
      );
    }

    function isValidReactionUpdate() {
      let data = request.resource.data;
      let current = resource.data;
      let prevLikes = ('likes' in current && current.likes is int) ? current.likes : 0;
      let prevDislikes = ('dislikes' in current && current.dislikes is int) ? current.dislikes : 0;
      let dLikes = data.likes - prevLikes;
      let dDislikes = data.dislikes - prevDislikes;
      let prevReaction = ('users' in current && current.users is map && request.auth.uid in current.users)
        ? current.users[request.auth.uid]
        : null;
      let nextReaction = (request.auth.uid in data.users)
        ? data.users[request.auth.uid]
        : null;

      return isSignedIn()
        && data.keys().hasOnly(['likes', 'dislikes', 'users'])
        && data.likes is int && data.likes >= 0
        && data.dislikes is int && data.dislikes >= 0
        && data.users is map
        && (
          (!('users' in current) || !(current.users is map))
            ? data.users.keys().hasOnly([request.auth.uid])
            : data.users.diff(current.users).affectedKeys().hasOnly([request.auth.uid])
        )
        && (nextReaction == null || nextReaction in ['like', 'dislike'])
        && isValidReactionTransition(prevReaction, nextReaction, dLikes, dDislikes);
    }

    match /reactions/{noteId} {
      allow read: if isSignedIn();
      allow delete: if false;
      allow create: if isValidReactionCreate();
      allow update: if isValidReactionUpdate();
    }

    // ── Exam papers & evaluations (Managed strictly via backend Paper Service) ──
    match /exam_papers/{paperId} {
      allow read, write: if false;
    }
    match /paper_model_answers/{paperId} {
      allow read, write: if false;
    }
    match /paper_evaluations/{paperId} {
      allow read, write: if false;
    }


    // ── NeoLearn: Report validation helpers ───────────────────────────────────

    function isValidNeoLearnReportReason(reason) {
      return reason in ['Spam', 'Inappropriate content', 'Harassment', 'Other'];
    }

    function isValidNeoLearnPostReport(reportId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'postId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'post'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 256
        && !request.resource.data.postId.matches('.*[/].*')
        && (request.resource.data.reportedUserId == null || request.resource.data.reportedUserId is string)
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'post_' + request.auth.uid + '_' + request.resource.data.postId;
    }

    function isValidNeoLearnProfileReport(reportId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.type == 'profile'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reportedUserId.size() <= 128
        && !request.resource.data.reportedUserId.matches('.*[/].*')
        && request.resource.data.reportedUserId != request.auth.uid
        && isValidNeoLearnReportReason(request.resource.data.reason)
        && request.resource.data.createdAt is timestamp
        && reportId == 'profile_' + request.auth.uid + '_' + request.resource.data.reportedUserId;
    }

    function isValidNeoLearnBlock(blockId) {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedUserId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId.size() > 0
        && request.resource.data.blockedUserId.size() <= 128
        && !request.resource.data.blockedUserId.matches('.*[/].*')
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.createdAt is timestamp
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId;
    }

    // ── NeoLearn profiles ─────────────────────────────────────────────────────
    // Clients can read any profile (public feed). Create is validated; updates/deletes via Admin SDK.
    match /neolearn_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'name', 'profilePhotoUrl', 'thoughtOfTheDay', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.profilePhotoUrl is string
        && request.resource.data.profilePhotoUrl.size() <= 2048
        && request.resource.data.thoughtOfTheDay is string
        && request.resource.data.thoughtOfTheDay.size() <= 280
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if false;  // Admin SDK only
    }

    // ── NeoLearn posts ────────────────────────────────────────────────────────
    // Authenticated users can read. Owner can delete own post. Creates/updates via Admin SDK.
    match /neolearn_posts/{postId} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // ── NeoLearn moments ─────────────────────────────────────────────────────
    match /neolearn_moments/{momentId} {
      allow read, write: if false;  // Admin SDK only
    }

    // ── NeoLearn reports ─────────────────────────────────────────────────────
    // Users can submit a report for a post or profile; no reads or updates.
    match /neolearn_reports/{reportId} {
      allow create: if isValidNeoLearnPostReport(reportId) || isValidNeoLearnProfileReport(reportId);
      allow read, update, delete: if false;
    }

    // ── NeoLearn blocks ───────────────────────────────────────────────────────
    // Users can block/unblock through the validated Admin SDK route or client read/delete.
    match /neolearn_blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isValidNeoLearnBlock(blockId);
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ── NeoLearn learning connections ─────────────────────────────────────────
    match /neolearn_learning/{relationId} {
      allow read: if isSignedIn();
      allow write: if false;  // Admin SDK only
    }

    // ── Impression tracking ───────────────────────────────────────────────────
    // Admin SDK transactions are the only write path; clients cannot forge counts.
    match /neolearn_post_impressions/{viewerUid} {
      allow read, write: if false;   // top-level: no direct client access

      match /posts/{postId} {
        allow read: if isSignedIn() && request.auth.uid == viewerUid;
        allow write: if false;   // all writes via Admin SDK (bypasses rules)
      }
    }

    // ── NeoBook collections (AI Notebook & RAG system) ────────────────────────
    // Client writes are completely blocked; all creations, updates, deletions,
    // and quota tracking are performed exclusively via backend Admin SDK.

    // 1. Daily usage tracking (chats & tokens per identityKey/IP/UID) - Admin SDK only
    match /neobook_usage/{docId} {
      allow read, write: if false;
    }

    // 2. Chunks generated from source documents - Admin SDK only
    match /neobook_chunks/{chunkId} {
      allow read, write: if false;
    }

    // 3. Notebook metadata - Authenticated owners can read their own notebooks; writes via Admin SDK only
    match /neobook_notebooks/{notebookId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 4. Source documents - Authenticated owners can read their own sources; writes via Admin SDK only
    match /neobook_sources/{sourceId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 5. Chat sessions - Authenticated owners can read their own chats; writes via Admin SDK only
    match /neobook_chats/{chatId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Folders are exposed read-only to their authenticated owner. The backend
    // performs every mutation and validates ownership/allowed fields.
    match /neobook_folders/{folderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /neobook_flashcard_sets/{setId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /neobook_study_guides/{guideId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /neobook_mindmaps/{mapId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 6. Chat messages - Authenticated owners can read messages matching their UID or ownerKey; writes via Admin SDK only
    match /neobook_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.ownerKey == 'uid_' + request.auth.uid
      );
      allow write: if false;
    }

    // ── Default: deny all unmatched paths ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
