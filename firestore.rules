rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_activity/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mentor_memory/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_goals/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_chat/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_reflections/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{reflectionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_calendar/{userId} {
      allow read, write: if isOwner(userId);
      match /days/{dayId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mentor_analytics/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /reactions/{noteId} {
      allow read, write: if request.auth != null;
    }

    match /aiboard_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /whatsapp_queue/{docId} {
      allow read, write: if false;
    }

    match /neolearn_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}