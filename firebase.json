        "type": 308
      },
      {
        "source": "/htmls/classs9-10mathematics.html",
        "destination": "/Notes/notes-math-class10.html",
        "type": 308
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
