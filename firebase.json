{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      ".git/**",
      "**/.git/**",
      ".github/**",
      ".*/**",
      "**/.*/**",
      ".*",
      "**/.env*",
      ".env*",
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.js.map",
      "**/*.ts.map",
      "**/*.log",
      "**/*.py",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.test.js",
      "**/*.md",
      "**/*.rules",
      "**/*lock.json",
      "**/package.json",
      "**/functions/**",
      "**/middleware/**",
      "**/routes/**",
      "**/services/**",
      "utils/**",
      "**/scripts/**",
      "**/.github/**",
      "**/.firebase/**",
      "**/*.mp4",
      "**/*.mkv",
      "**/*.avi",
      "**/*.mov",
      "dump.rdb",
      "server.js",
      "firebaseAdmin.js",
      "gemini-models.js",
      "mock-firebase.js",
      "neolearn-*-handler.js",
      "test_*.js",
      "test-*.js",
      "test-runner.js",
      "NeoBot/server.js",
      "NeoBot/backend/**",
      "NeoBot/test-*.js",
      "patch.py",
      "patch2.py",
      "requirement.txt",
      "package.json",
      "package-lock.json",
      "vercel.json",
      "READEM.md",
      "profilem.md",
      "profiles_solution.md",
      "git checkout Final Commit",
      "screenshot_images/**",
      "functions/**",
      "database.rules.json",
      "firebase.rtdb-emulator.json",
      "firestore.indexes.json",
      "ai-conversation-handler.js",
      "ai-upload-handler.js",
      "neolearn-social-data.js",
      "neolearn-social-handler.js",
      "neolearn-impression-handler.js",
      "neolearn-message-handler.js",
      "neolearn-moderation-handler.js",
      "neolearn-notification-handler.js",
      "neolearn-upload-handler.js",
      "neolearn-moment-handler.js",
      "dump_msgs.js",
      "index.js",
      "search.js",
      "update_html.js",
      "patch_messages.js",
      "patch_messages_empty.js",
      "patch_messages_presence.js",
      "patch_settings.js",
      "patch_settings_privacy.js",
      "patch_js.cjs",
      "fix_social.js",
      "fix_social.cjs",
      "fix_social2.cjs",
      "test_admin.js",
      "test_dotenv.js",
      "test_main.js",
      "test_main2.js",
      "test_main3.js",
      "architecture-map.html",
      "pages.txt",
      "sample-prompt.txt",
      "transcript_outputs.txt",
      "ai-conversation-handler.test.js",
      "ai-upload-handler.test.js",
      "ai-quota-ui.test.js",
      "firebase-hosting-assets.test.js",
      "leaderboard.test.js",
      "neolearn-directory-handler.test.js",
      "neolearn-impression-handler.test.js",
      "neolearn-message-handler.test.js",
      "neolearn-message-history.test.js",
      "neolearn-moderation.test.js",
      "neolearn-moment-handler.test.js",
      "neolearn-notification-handler.test.js",
      "neolearn-notifications-service.test.js",
      "neolearn-privacy-settings.test.js",
      "neolearn-rtdb.test.js",
      "neolearn-social-client.test.js",
      "neolearn-social-handler.test.js",
      "neolearn-upload-handler.test.js",
      "neolearn-feed-history.test.js",
      "paper-generator.test.js",
      "phase4.test.js",
      "rankingAlgorithm.test.js",
      "require-auth-quota.test.js",
      "gemini-models.test.js",
      "neobook-quiz-service.test.js",
      "rtdb-rules-emulator.test.js",
      "service-worker.test.js",
      "security.test.js",
      "tests/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|eot|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/about",
        "destination": "/about.html",
        "type": 308
      },
      {
        "source": "/founder",
        "destination": "/founder.html",
        "type": 308
      },
      {
        "source": "/contact",
        "destination": "/htmls/contactus.html",
        "type": 308
      },
      {
        "source": "/privacy",
        "destination": "/htmls/privacy.html",
        "type": 308
      },
      {
        "source": "/terms",
        "destination": "/htmls/terms_conditions.html",
        "type": 308
      },
      {
        "source": "/htmls/classs9-10mathematics.html",
        "destination": "/Notes/notes-math-class10.html",
        "type": 308
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
