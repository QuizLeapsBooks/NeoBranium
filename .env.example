# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your_session_secret
ALLOWED_ORIGINS=http://localhost:5500,https://neobranium.web.app

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=neobranium
FIREBASE_CLIENT_EMAIL=your_client_email@neobranium.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Cloudinary Configuration (Server-Side Only - Configure as Render Environment Variables)
# IMPORTANT: Never expose Cloudinary API secrets in client-side code or public repositories.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI & Third-Party APIs
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
REDIS_URL=redis://localhost:6379
